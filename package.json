{
  "name": "listingwriter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=\"-r ./polyfill.js\" expo start",
    "android": "cross-env NODE_OPTIONS=\"-r ./polyfill.js\" expo start --android",
    "ios": "cross-env NODE_OPTIONS=\"-r ./polyfill.js\" expo start --ios",
    "web": "cross-env NODE_OPTIONS=\"-r ./polyfill.js\" expo start --web --port 8082",
    "build:web": "cross-env NODE_OPTIONS=\"-r ./polyfill.js\" expo export -p web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.31",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "^18.0.13",
    "expo-file-system": "^19.0.21",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "^8.0.11",
    "expo-router": "^6.0.21",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.9",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
